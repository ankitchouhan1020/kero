{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sora",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  // TanStack Start's server entry. The @cloudflare/vite-plugin bundles this
  // into the deployed Worker and wires up the built client as static assets.
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "routes": [{ "pattern": "sora.ankitchouhan.dev", "custom_domain": true }]
}
